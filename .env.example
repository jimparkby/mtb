# Скопируйте в окружение сервиса (Railway → Variables) или экспортируйте локально.
# PostgreSQL; без него — SQLite в data/kopi.db
# DATABASE_URL=postgres://user:pass@host:5432/kopi
# PGSSL=true
# PUBLIC_URL=https://kopi.example.by

# Платёжный провайдер: ключи bePaid или тестовый провайдер
# BEPAID_SHOP_ID=
# BEPAID_SECRET_KEY=
# BEPAID_TEST=true
# PAYMENTS_PROVIDER=sandbox

# Секрет подписи уведомлений банка-партнёра
# BANK_WEBHOOK_SECRET=
